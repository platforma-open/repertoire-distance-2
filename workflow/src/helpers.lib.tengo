maps := import("@platforma-sdk/workflow-tengo:maps")
canonical := import("@platforma-sdk/workflow-tengo:canonical")

export {
	getLabel: func(mt) {
		if mt == "F1" {
			return "F1 Score"
		} else if mt == "F2" {
			return "F2 Score"
		} else if mt == "jaccard" {
			return "Jaccard Index"
		} else if mt == "D" {
			return "D Score"
		} else if mt == "correlation" {
			return "Correlation"
		}
		return mt
	},

	// The two sample axes keep the plain `pl7.app/sampleId` domain of the input,
	// and the side of the pair each one stands for goes into `contextDomain`.
	// `domain` is matched by exact equality, so a side marker there would leave
	// both axes unequal to the `pl7.app/sampleId` every other block emits and no
	// sample metadata would ever attach to the heatmap. `contextDomain` is
	// matched by kinship, so the axes stay canonical while still carrying the
	// marker. The model folds it back into `domain` when it builds the PFrame,
	// where axes are joined by exact domain and the two sides must stay apart.
	getFullSpecs: func(abundanceSpec, metrics) {
		return {
			axes: [{
				column: "sample1",
				spec: {
					name: "pl7.app/sampleId",
					type: "String",
					domain: abundanceSpec.axesSpec[0].domain,
					contextDomain: {
						"pl7.app/overlap": "left"
					},
					annotations: {
						"pl7.app/label": "Sample 1"
					}
				}
			},
			{
				column: "sample2",
				spec: {
					name: "pl7.app/sampleId",
					type: "String",
					domain: abundanceSpec.axesSpec[0].domain,
					contextDomain: {
						"pl7.app/overlap": "right"
					},
					annotations: {
						"pl7.app/label": "Sample 2"
					}
				}
			},
			{
				column: "metric",
				spec: {
					name:"pl7.app/overlapMetric",
					type: "String",
					domain: abundanceSpec.axesSpec[0].domain,
					annotations: {
						"pl7.app/label": "Overlap Metric"
					}
				}
			}],
			columns: [{
				column: "value",
				spec: {
					name: "pl7.app/overlap",
					valueType: "Float",
					domain: maps.merge(
						abundanceSpec.domain,
						{
							"pl7.app/downsampling": canonical.encode(metrics[0].downsampling)
						}
					),
					annotations: {
						"pl7.app/label": "Repertoire distance"
					}
				}
			}],
			storageFormat: "Parquet",
			partitionKeyLength: 0
		}
	}
}

